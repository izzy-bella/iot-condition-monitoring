# Placeholder names only. On the Raspberry Pi, keep the populated secret file at
# /home/isabella/.env. The application loads that exact path. Never commit it.

DEVICE_ID=fan-monitor-pi
TELEMETRY_INTERVAL_SECONDS=10
PUBLISH_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
BASELINE_ACQUISITION_MODE=false
SENSORS_CONFIG=../config/sensors.yaml
THRESHOLDS_CONFIG=../config/thresholds.yaml
FMECA_CONFIG=../config/fmeca.yaml
EVENT_DB_PATH=./data/fault_history.db

# Existing Azure IoT Hub path. Replace placeholders only in the runtime environment.
AZURE_IOT_ENABLED=true
AZURE_IOT_DEVICE_CONNECTION_STRING=HostName=<iot-hub>.azure-devices.net;DeviceId=<device-id>;SharedAccessKey=<device-key>

# Local InfluxDB or a cloud-accessible InfluxDB endpoint used by Grafana Cloud.
# Grafana Cloud cannot reach a Raspberry Pi localhost URL across the internet.
INFLUXDB_ENABLED=true
INFLUXDB_URL=<https://your-cloud-accessible-influxdb-endpoint>
INFLUXDB_TOKEN=<influxdb-token>
INFLUXDB_ORG=<influxdb-organisation>
INFLUXDB_BUCKET=<influxdb-bucket>
INFLUXDB_MEASUREMENT=fan_condition
INFLUXDB_TIMEOUT_MS=5000
