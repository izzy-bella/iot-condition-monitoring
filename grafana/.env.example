# Self-hosted Grafana provisioning placeholders. Grafana Cloud credentials are
# entered through its secure data-source configuration, not committed here.
INFLUXDB_URL=<https://cloud-accessible-influxdb-endpoint>
INFLUXDB_BUCKET=<influxdb-bucket>
INFLUXDB_GRAFANA_READ_TOKEN=<read-only-influxdb-token>
DEVICE_ID=fan-monitor-pi
STALE_TIMEOUT_SECONDS=30
