            "type": "influxdb",
            "uid": "iiot-influxdb"
          },
          "query": "WITH latest AS (\n  SELECT time, \"recommended_action\"\n  FROM \"fan_condition\"\n  WHERE \"deviceId\" = '${device_id}'\n  ORDER BY time DESC\n  LIMIT 1\n), action AS (\n  SELECT time,\n    CASE\n      WHEN time < now() - INTERVAL '${stale_timeout_seconds} seconds' THEN 'No recent telemetry received. Check Raspberry Pi, sensors and network connectivity.'\n      ELSE \"recommended_action\"\n    END AS recommended_action\n  FROM latest\n)\nSELECT time, recommended_action FROM action\nUNION ALL\nSELECT TIMESTAMP '1970-01-01 00:00:00', 'No recent telemetry received. Check Raspberry Pi, sensors and network connectivity.'\nORDER BY time DESC\nLIMIT 1",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ],
