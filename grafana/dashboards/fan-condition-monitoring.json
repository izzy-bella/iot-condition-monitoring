    {
      "datasource": {
        "type": "influxdb",
        "uid": "iiot-influxdb"
      },
      "description": "Live system status with a 30-second stale-data override. Missing telemetry can never be displayed as healthy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "System Status"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "-1": {
                        "color": "dark-red",
                        "index": 4,
                        "text": "OFFLINE / NO DATA"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "match": "null",
                      "result": {
                        "color": "dark-red",
                        "index": 3,
                        "text": "NO DATA"
                      }
                    },
                    "type": "special"
                  },
                  {
                    "options": {
                      "from": 0,
                      "result": {
                        "color": "red",
                        "index": 0,
                        "text": "CRITICAL"
                      },
                      "to": 49.999
                    },
                    "type": "range"
                  },
                  {
                    "options": {
                      "from": 50,
                      "result": {
                        "color": "yellow",
                        "index": 1,
                        "text": "WARNING"
                      },
                      "to": 79.999
                    },
                    "type": "range"
                  },
                  {
                    "options": {
                      "from": 80,
                      "result": {
                        "color": "green",
                        "index": 2,
                        "text": "NORMAL"
                      },
                      "to": 100
                    },
                    "type": "range"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "explanation"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Condition summary"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "-1": {
                        "color": "dark-red",
                        "index": 3,
                        "text": "No recent telemetry received. Check Raspberry Pi, sensors and network connection."
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "from": 0,
                      "result": {
                        "color": "red",
                        "index": 0,
                        "text": "Critical condition detected. Stop and inspect the system."
                      },
                      "to": 49.999
                    },
                    "type": "range"
                  },
                  {
                    "options": {
                      "from": 50,
                      "result": {
                        "color": "yellow",
                        "index": 1,
                        "text": "Operating limits are being approached. Investigation recommended."
                      },
                      "to": 79.999
                    },
                    "type": "range"
                  },
                  {
                    "options": {
                      "from": 80,
                      "result": {
                        "color": "green",
                        "index": 2,
                        "text": "Fan operating within normal limits. No active issues."
                      },
                      "to": 100
                    },
                    "type": "range"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "iiot-influxdb"
          },
          "query": "WITH latest AS (\n  SELECT time, \"condition_status\"\n  FROM \"fan_condition\"\n  WHERE \"deviceId\" = '${device_id}'\n  ORDER BY time DESC\n  LIMIT 1\n), scored AS (\n  SELECT time,\n    CASE\n      WHEN time < now() - INTERVAL '${stale_timeout_seconds} seconds' THEN -1.0\n      WHEN \"condition_status\" = 'NORMAL' THEN 92.0\n      WHEN \"condition_status\" = 'WARNING' THEN 65.0\n      WHEN \"condition_status\" = 'CRITICAL' THEN 25.0\n      ELSE -1.0\n    END AS state\n  FROM latest\n)\nSELECT time, state, state AS explanation FROM scored\nUNION ALL\nSELECT TIMESTAMP '1970-01-01 00:00:00', -1.0, -1.0\nORDER BY time DESC\nLIMIT 1",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ],
      "title": "System Status",
      "type": "stat"
    },
